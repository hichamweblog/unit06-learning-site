# الرابط العام للمنصة: يُستخدم في canonical و Open Graph و sitemap
# غيّره عند ربط نطاق مخصص
VITE_SITE_URL=https://manhaj-islam.vercel.app

# تحليلات اختيارية (بلا كوكيز). اتركها فارغة لتعطيلها.
